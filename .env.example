# Flask Application Configuration
# Copy this file to .env and update with your values

# Application settings
APP_ID=multilingual-blog
APP_NAME=My Multilingual Blog

# Server configuration
HOST=0.0.0.0
PORT=5000
# IMPORTANT: keep DEBUG=False in production — Werkzeug's debug console allows arbitrary code execution.
DEBUG=False
BASE_URL=http://localhost:5000

# Security — REQUIRED. The app refuses to start without this.
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY=

# Database
DATABASE_PATH=blog.db

# Scheduler settings (minutes)
SCHEDULER_INTERVAL=5

# Default language
DEFAULT_LANGUAGE=en

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_LOGIN=your-email@example.com
SMTP_PASSWORD=your-password-here
SMTP_FROM=no-reply@example.com
